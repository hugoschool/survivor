{
    "name": "frontend",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "react-router build",
        "dev": "react-router dev",
        "start": "react-router-serve ./build/server/index.js",
        "typecheck": "react-router typegen && tsc",
        "check": "biome check --write",
        "format": "biome format --write",
        "lint": "biome lint --write",
        "fix": "pnpm run check && pnpm run format && pnpm run lint",
        "ci": "biome ci"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "26.x",
            "onFail": "download"
        }
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@codegouvfr/react-dsfr": "^1.34.0",
        "@fmarlats/react-like-button": "^1.3.1",
        "@fontsource-variable/geist": "^5.3.0",
        "@lyket/react": "^2.1.0",
        "@react-router/node": "^8",
        "@react-router/serve": "^8",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "embla-carousel-react": "^8.6.0",
        "isbot": "^5.1.36",
        "lucide-react": "^1.37.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-player": "^3.4.0",
        "react-router": "^8",
        "react-vertical-feed": "^0.2.2",
        "shadcn": "^4.19.0",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.11",
        "@react-router/dev": "^8",
        "@tailwindcss/vite": "^4.2.2",
        "@types/node": "^22",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "tailwindcss": "^4.2.2",
        "typescript": "^5.9.3",
        "vite": "^8.0.3"
    }
}
